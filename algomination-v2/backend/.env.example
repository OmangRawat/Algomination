# Copy this file to `.env` and adjust for your environment.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# CORS — origins allowed to call the API (the Next.js frontend)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database — leave unset for local SQLite. In production set a Postgres URL, e.g.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_URL=

# Production only: set False if your host already terminates TLS for you.
# DJANGO_SECURE_SSL_REDIRECT=True
